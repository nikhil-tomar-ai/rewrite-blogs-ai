# ==============================================================================
# AI-Powered CSV Blog Humanization Platform - Environment Configuration
# ==============================================================================

# Server Network Configuration
PORT=3000
NODE_ENV=development

# Database Storage (SQLite path for local single-file database; easily migrates to PostgreSQL)
DATABASE_URL="file:./storage/dev.db"

# Storage Directories
UPLOAD_DIR="./storage/uploads"
EXPORT_DIR="./storage/exports"
TEMP_DIR="./storage/temporary"

# Ollama AI Integration (Local or Cloud)
# For local Ollama: "http://localhost:11434"
# For Ollama Cloud: "https://ollama.com" or your remote endpoint
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.1:8b"
# Ollama Cloud API Key (Leave empty if running 100% offline local Ollama)
OLLAMA_API_KEY=""

# File Upload Constraints
MAX_FILE_SIZE_MB=500

# Batch Processing & Resilience Engine
DEFAULT_BATCH_SIZE=10
MAX_RETRIES=3
RETRY_BASE_DELAY_MS=1000

# Fallback AI & Testing Providers (Optional)
FALLBACK_AI_ENABLED=true
