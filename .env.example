# SparkyAI / Local Content Humanizer - Environment Configuration
# 100% Local & Open Source Execution

APP_ENV=development
PORT=3000

# AI Provider Selection
# Supported values: 'ollama-cloud', 'ollama-local', 'openai_local', 'fallback'
AI_PROVIDER=ollama-local

# Ollama Cloud Configuration
OLLAMA_CLOUD_BASE_URL=https://ollama.com/api
OLLAMA_CLOUD_MODEL=
OLLAMA_CLOUD_API_KEY=

# Local Ollama Configuration
OLLAMA_LOCAL_BASE_URL=http://localhost:11434
OLLAMA_LOCAL_MODEL=llama3.1:8b

# Default Generation Parameters
DEFAULT_TEMPERATURE=0.7
MAX_CONCURRENCY=2

# Local Database & File Storage Settings
DATABASE_URL=file:./data/sparkyai_local_db.json
STORAGE_PROVIDER=local
STORAGE_DIR=./storage
