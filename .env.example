# SparkyAI / Local Content Humanizer - Environment Configuration
# 100% Local & Open Source Execution

APP_ENV=development
PORT=3000

# Local AI Provider Configuration
# Supported values: 'ollama' (default), 'openai_local' (LM Studio / vLLM), 'fallback' (rule engine)
LLM_PROVIDER=ollama

# Ollama Base Endpoint URL (default local port 11434)
OLLAMA_BASE_URL=http://localhost:11434

# Local Ollama Model Name (e.g. llama3.1:8b, llama3.2, mistral, qwen2.5, gemma2)
OLLAMA_MODEL=llama3.1:8b

# Default Generation Parameters
DEFAULT_TEMPERATURE=0.7
MAX_CONCURRENCY=2

# Local Database & File Storage Settings
DATABASE_URL=file:./data/sparkyai_local_db.json
STORAGE_PROVIDER=local
STORAGE_DIR=./storage
